# backend/.env.production
# [운영 AD 환경 설정]
# 운영 메타데이터 XML 내 <SingleSignOnService> URL
SAML_ENTRY_POINT=https://stsds.secsso.net/adfs/ls/

# 운영 서버에 배포 시 해당 도메인으로 변경 필요 (AD 등록 값과 일치해야 함)
SAML_ISSUER=https://[Web서버IP]:8080

# 운영 서버 콜백 주소 (외부에서 8080 포트로 들어와 프록시를 통해 백엔드로 전달됨)
SAML_CALLBACK_URL=https://[Web서버IP]]:8080/api/auth/callback

# [중요] 운영용 메타데이터 XML 안의 <X509Certificate> 값
SAML_IDP_CERT=MIID... (운영용 인증서 값) ...

# 기타 설정 (내부 백엔드 구동 포트)
PORT=3000

# 로그인 성공 후 돌려보낼 실제 프론트엔드 URL
FRONTEND_URL=https://[Web서버IP]:8080/login

# Data API Base URL (마지막 슬래시 제외, 필요 시 실제 Data API 운영 서버 IP로 변경)
DATA_API_HOST=http://[Data-API서버IP]:8081

# [필수] SP 개인키 (개발용과 동일하거나, 운영용으로 별도 발급받은 키 사용)
# AD에 보낼 요청(AuthnRequest)을 서명할 때 사용
SAML_SP_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----
... (기존 값) ...
-----END PRIVATE KEY-----"

# [필수] SP 공개키
# 메타데이터(/api/auth/metadata) 생성 시 포함되어 AD가 우리를 검증할 때 사용
SAML_SP_PUBLIC_CERT="-----BEGIN CERTIFICATE-----
... (기존 값) ...
-----END CERTIFICATE-----"

# [Knox Mail API 설정]
KNOX_API_HOST="https://openapi.stage.samsung.net"
KNOX_ACCOUNT_ID="[AccountID]"
KNOX_ACCESS_TOKEN="[Access Token]"
KNOX_SENDER_EMAIL="ivision@samsung.com"
