# backend/.env.development

# [개발 AD 환경 설정]
# 개발 메타데이터 XML 내 <SingleSignOnService>의 Location URL (보통 /adfs/ls/로 끝남)
# 예: entityID가 http://stsds-dev... 이면 보통 아래와 같음
SAML_ENTRY_POINT="https://stsds-dev.secsso.net/adfs/ls/"

# AD에 등록한 이 시스템(SP)의 식별자 (개발 PC인 경우 localhost 유지)
SAML_ISSUER="https://10.135.77.222:8080/"

# 인증 후 돌아올 콜백 주소
SAML_CALLBACK_URL="https://10.135.77.222:8080/api/auth/callback"

# 기타 설정 (내부 백엔드 구동 포트)
PORT=44364

# [프론트엔드 리다이렉트 주소]
# AD 로그인 성공 후, 백엔드가 사용자를 돌려보낼 실제 화면(UI) 주소
FRONTEND_URL="https://10.135.77.222:8080/login"

# Data API URL (http://[ITM-Data-API서버주소]:8081 - 마지막 슬래시 제외)
DATA_API_HOST="http://10.172.111.88:8081"

# [AD 인증 (SAML) 활성화]
# 개발 PC에서도 전용 개발 AD 서버를 통해 인증을 진행합니다.
USE_SAML_AUTH=true

# [개발용 SAML 인증서] 개발용 메타데이터 XML 안의 <X509Certificate> 값 (줄바꿈 없이 한 줄로)
SAML_IDP_CERT="-----BEGIN CERTIFICATE-----
MIIC5DCCA...
-----END CERTIFICATE-----"

# 2. SP_CERT / PRIVATE_KEY: 개발 PC용으로 생성(또는 발급)한 키를 넣습니다.
# (이 공개키(SP_CERT)는 사전에 개발용 AD 서버 담당자에게 등록되어 있어야 합니다.)
SAML_SP_PUBLIC_CERT="-----BEGIN CERTIFICATE-----
MIIGJzCCB...
-----END CERTIFICATE-----"

SAML_SP_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----
MIIEvgIBADAN...
-----END PRIVATE KEY-----"

# [Knox Mail API 설정]
KNOX_API_HOST="https://openapi.stage.samsung.net"
KNOX_ACCOUNT_ID="[AccountID]"
KNOX_ACCESS_TOKEN="[Access Token]"
KNOX_SENDER_EMAIL="gily.choi@stage.samsung.com"
